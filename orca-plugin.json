{
  "manifestVersion": 2,
  "id": "agent-profiles",
  "name": "Agent Profiles",
  "version": "2.2.0",
  "description": "Launch Orca's agents with saved profiles: model, effort, extra arguments and, for Claude, a provider such as Ollama or OpenRouter.",
  "author": {
    "name": "Romain Ecarnot",
    "url": "https://github.com/eRom"
  },
  "repository": "https://github.com/eRom/orca-plugin-agent-profiles",
  "license": "MIT",
  "icon": "media/icon.png",
  "cover": {
    "path": "media/cover.png",
    "alt": "The Agents panel with profiles grouped by agent, beside the command a Claude profile launches through Ollama."
  },
  "screenshots": [
    {
      "path": "media/screenshot-light.png",
      "alt": "The Agents panel in Orca's light theme: Antigravity and Claude groups, each profile with its model, effort, launch and edit buttons.",
      "caption": "Follows Orca's theme"
    },
    {
      "path": "media/screenshot-form-dark.png",
      "alt": "The dark profile form for a Claude profile: name, avatar, model glm-5.3:cloud[1m], effort Max, provider Ollama, extra arguments.",
      "caption": "One profile, every setting",
      "theme": "dark"
    },
    {
      "path": "media/screenshot-form-light.png",
      "alt": "The same profile form in the light theme.",
      "caption": "One profile, every setting",
      "theme": "light"
    }
  ],
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "agent:launch"
    },
    {
      "kind": "storage:own"
    }
  ],
  "contributes": {
    "panels": [
      {
        "id": "agents",
        "title": "Agents",
        "icon": "bot",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      {
        "id": "agentProfiles.relaunchLast",
        "title": "Agents: relaunch last profile",
        "when": "workspace"
      },
      {
        "id": "agentProfiles.launchSlot1",
        "title": "Agents: launch profile 1",
        "when": "workspace"
      },
      {
        "id": "agentProfiles.launchSlot2",
        "title": "Agents: launch profile 2",
        "when": "workspace"
      },
      {
        "id": "agentProfiles.launchSlot3",
        "title": "Agents: launch profile 3",
        "when": "workspace"
      },
      {
        "id": "agentProfiles.launchSlot4",
        "title": "Agents: launch profile 4",
        "when": "workspace"
      },
      {
        "id": "agentProfiles.launchSlot5",
        "title": "Agents: launch profile 5",
        "when": "workspace"
      },
      {
        "id": "agentProfiles.launchSlot6",
        "title": "Agents: launch profile 6",
        "when": "workspace"
      },
      {
        "id": "agentProfiles.launchSlot7",
        "title": "Agents: launch profile 7",
        "when": "workspace"
      },
      {
        "id": "agentProfiles.launchSlot8",
        "title": "Agents: launch profile 8",
        "when": "workspace"
      },
      {
        "id": "agentProfiles.launchSlot9",
        "title": "Agents: launch profile 9",
        "when": "workspace"
      }
    ],
    "keybindings": [
      {
        "command": "agentProfiles.relaunchLast",
        "key": "Mod+Alt+L",
        "when": "workspace"
      },
      {
        "command": "agentProfiles.launchSlot1",
        "key": "Mod+Alt+1",
        "when": "workspace"
      },
      {
        "command": "agentProfiles.launchSlot2",
        "key": "Mod+Alt+2",
        "when": "workspace"
      },
      {
        "command": "agentProfiles.launchSlot3",
        "key": "Mod+Alt+3",
        "when": "workspace"
      },
      {
        "command": "agentProfiles.launchSlot4",
        "key": "Mod+Alt+4",
        "when": "workspace"
      },
      {
        "command": "agentProfiles.launchSlot5",
        "key": "Mod+Alt+5",
        "when": "workspace"
      },
      {
        "command": "agentProfiles.launchSlot6",
        "key": "Mod+Alt+6",
        "when": "workspace"
      },
      {
        "command": "agentProfiles.launchSlot7",
        "key": "Mod+Alt+7",
        "when": "workspace"
      },
      {
        "command": "agentProfiles.launchSlot8",
        "key": "Mod+Alt+8",
        "when": "workspace"
      },
      {
        "command": "agentProfiles.launchSlot9",
        "key": "Mod+Alt+9",
        "when": "workspace"
      }
    ],
    "hooks": [
      {
        "event": "agent.launch.before"
      }
    ]
  }
}
